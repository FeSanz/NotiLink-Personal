<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.NotiLink" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Base palette (same as the PC app). The accent itself follows the PC at runtime
             (AccentTheme); these are the defaults for dialogs, cursors and anything not re-tinted. -->
        <item name="colorPrimary">@color/accent_default</item>
        <item name="colorPrimaryVariant">#6A4BEE</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">@color/accent_default</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="android:windowBackground">@color/app_bg</item>
        <item name="android:colorBackground">@color/app_bg</item>
    </style>

    <!-- ShareToPcActivity's theme — no visible window of its own, just a brief toast, so
         sharing a link to NotiLink never flashes an empty screen before returning control
         to whatever app the user shared from. -->
    <style name="Theme.NotiLink.Transparent" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="SectionTitle">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">#888888</item>
        <item name="android:letterSpacing">0.03</item>
    </style>

    <style name="RoundedButton" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">20dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <!-- Acciones / Permisos switch at the top of the main screen. -->
    <style name="SegmentButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="strokeColor">#7C5CFF</item>
        <item name="android:textColor">@color/segment_text</item>
        <item name="backgroundTint">@color/segment_bg</item>
    </style>

    <style name="RoundedOutlinedButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">20dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
