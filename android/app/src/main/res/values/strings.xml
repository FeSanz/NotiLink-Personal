    <!-- Unified permissions list — same shape for every row (title + status subtitle + a
         Switch that only reflects state). Tapping a row that's off launches the grant flow;
         tapping one that's on opens wherever it can actually be revoked. -->
    <string name="perm_title_notification_access">Acceso a notificaciones</string>
    <string name="perm_subtitle_notification_access_on">Activo — toca para revisar o desactivar</string>
    <string name="perm_subtitle_notification_access_off">Necesario para recibir tus notificaciones en la PC. Toca para activarlo</string>

    <string name="perm_title_battery">Optimización de batería</string>
    <string name="perm_subtitle_battery_on">Sin restricciones — toca para gestionar</string>
    <string name="perm_subtitle_battery_off">Puede cortar la conexión con la pantalla bloqueada. Toca para permitir actividad en segundo plano</string>

    <string name="perm_title_post_notifications">Notificaciones de NotiLink</string>
    <string name="perm_subtitle_post_notifications_on">Activo — toca para gestionar</string>
    <string name="perm_subtitle_post_notifications_off">Necesario para el aviso de estado en segundo plano. Toca para activarlo</string>

    <string name="perm_title_photos">Fotos</string>
    <string name="perm_subtitle_photos_on">Activo — toca para gestionar</string>
    <string name="perm_subtitle_photos_off">Necesario para mostrar tu fondo de pantalla en la PC. Toca para activarlo</string>

    <string name="perm_title_location">Ubicación</string>
    <string name="perm_subtitle_location_on">Activa — toca para gestionar</string>
    <string name="perm_subtitle_location_off">Necesaria para mostrar la red Wi-Fi conectada. Toca para activarla</string>

    <string name="perm_title_phone_state">Estado del teléfono</string>
    <string name="perm_subtitle_phone_state_on">Activo — toca para gestionar</string>
    <string name="perm_subtitle_phone_state_off">Necesario para mostrar los datos móviles. Toca para activarlo</string>

    <string name="accessibility_service_description">Permite que NotiLink abra una notificación específica en este teléfono cuando lo pides desde la PC — el mismo efecto que tocarla tú mismo. No lee ni envía el contenido de la pantalla para ningún otro fin.</string>
    <string name="perm_title_accessibility">Abrir notificaciones desde la PC</string>
    <string name="perm_subtitle_accessibility_on">Activo — toca para gestionar</string>
    <string name="perm_subtitle_accessibility_off">Opcional. Permite abrir una notificación específica desde la PC, como si la tocaras en el teléfono. Toca para activarlo</string>
    <string name="perm_title_answer_calls">Contestar llamadas desde la PC</string>
    <string name="perm_subtitle_answer_calls_on">Activo — toca para gestionar</string>
    <string name="perm_subtitle_answer_calls_off">Opcional. Permite contestar y colgar llamadas desde los botones de la PC. Toca para activarlo</string>
    <string name="perm_title_rotation">Controlar la rotación desde la PC</string>
    <string name="perm_subtitle_rotation_on">Activo — toca para gestionar</string>
    <string name="perm_subtitle_rotation_off">Opcional. Permite activar/desactivar la rotación automática desde el botón de la PC (permiso "Modificar ajustes del sistema"). Toca para activarlo</string>
    <string name="perm_title_dnd">Activar No molestar desde la PC</string>
    <string name="perm_subtitle_dnd_on">Activo — toca para gestionar</string>
    <string name="perm_subtitle_dnd_off">Opcional. Permite activar/desactivar el modo No molestar del teléfono desde el botón de la PC. Toca para activarlo</string>

