<?xml version="1.0" encoding="utf-8"?>
<!-- Body of the persistent status notification (DecoratedCustomViewStyle keeps the system header):
     the status text plus icon-only buttons — Android 12+ always draws a notification action's
     text, never its icon, so real icons need a custom view. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="48dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/notif_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@android:style/TextAppearance.Material.Notification" />

    <ImageView
        android:id="@+id/notif_btn_toggle"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="8dp"
        android:contentDescription="Conectar o desconectar" />

    <ImageView
        android:id="@+id/notif_btn_screen"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="8dp"
        android:src="@drawable/ic_action_screen_share"
        android:contentDescription="Compartir pantalla" />

    <ImageView
        android:id="@+id/notif_btn_audio"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="8dp"
        android:src="@drawable/ic_action_audio_share"
        android:contentDescription="Compartir audio" />

    <ImageView
        android:id="@+id/notif_btn_power"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="8dp"
        android:src="@drawable/ic_notif_power"
        android:contentDescription="Apagar NotiLink" />
</LinearLayout>
