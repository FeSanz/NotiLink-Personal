<?xml version="1.0" encoding="utf-8"?>
<!-- One row in the unified "Permisos y optimización" list — same shape for every permission
     so nothing looks like a one-off (title + status subtitle + a Switch that only reflects
     state, never toggled directly: the whole row is clickable and routes to either the in-app
     request flow or the system settings screen where it can actually be revoked). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="12dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginEnd="12dp">

        <!-- textColorPrimary (not a hardcoded hex) — it's the one already correctly DayNight-
             adaptive elsewhere in this app; a fixed dark color here went invisible on the
             black background in dark mode, the same class of bug as bg_pairing_code's text. -->
        <TextView
            android:id="@+id/rowTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textColor="?android:attr/textColorPrimary" />

        <TextView
            android:id="@+id/rowSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="12sp"
            android:textColor="#888888" />
    </LinearLayout>

    <Switch
        android:id="@+id/rowSwitch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false" />

</LinearLayout>
